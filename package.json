{
  "name": "docnest-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && .\\.venv\\Scripts\\uvicorn.exe app.main:app --port 8000 --reload --app-dir .",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
