# Copy this file to .env and fill in local values.
# Never commit real secrets.

# Backend
DOCNEST_ENV=development
DOCNEST_SECRET_KEY=change-me-to-a-long-random-string
DOCNEST_MASTER_KEY=base64-encoded-32-byte-key
DATABASE_URL=sqlite:///./docnest.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://docnest:docnest@localhost:5432/docnest
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# Integrity: database | blockchain
INTEGRITY_MODE=database

# Optional local Hardhat RPC
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=

# Optional email reminders (disabled by default)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=docnest@localhost
